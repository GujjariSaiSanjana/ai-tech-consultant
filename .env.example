# Required for real model calls. Tests run without them (mocked).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Fallback LLMs, used only when Claude is unavailable (rate limit, 5xx, network) or has no key.
# Both use their OpenAI-compatible endpoints. Leave a key empty to skip that provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Order to try; empty disables fallback.
LLM_FALLBACK_ORDER=gemini,nvidia

# Knowledge Brain (Task 1)
BRAIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brain
BRAIN_API_KEY=dev-brain-key
BRAIN_URL=http://localhost:8000

# Inbox Agent (Task 2)
INBOX_DATABASE_PATH=./data/runtime/inbox.db

# Scope of Work (Task 3)
SCOPE_DATABASE_URL=sqlite+aiosqlite:///./data/runtime/scope.db

# Reporting
USD_TO_INR=94.59
