# Copy to inbox/.env.local. Everything is optional: without keys the app runs offline.

# Real model calls (Haiku 5.5 for screen/classify/judge, Sonnet 5.5 for draft/reflect).
ANTHROPIC_API_KEY=
# Force the offline fake model even when a key is set.
INBOX_MOCK_LLM=

# Optional semantic embeddings for episodic memory; falls back to a deterministic hashing embedder.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

INBOX_DATABASE_PATH=./data/runtime/inbox.db

# Where facts come from: fake (built-in simulated knowledge base), http (Brain REST API), mcp (Brain MCP server).
INBOX_BRAIN_MODE=fake
BRAIN_URL=http://localhost:8000
BRAIN_API_KEY=dev-brain-key
BRAIN_MCP_COMMAND=python
BRAIN_MCP_ARGS=-m brain.mcp_server
BRAIN_MCP_CWD=../brain
